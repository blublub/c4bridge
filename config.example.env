# Copy to ~/.config/c4bridge/config.env, then: chmod 600 ~/.config/c4bridge/config.env
C4_USER=you@example.com
C4_PASS=
C4_IP=192.168.1.50

# Web UI login (empty = no login; only acceptable on 127.0.0.1)
BRIDGE_WEB_USER=
BRIDGE_WEB_PASS=
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8080
# HTTPS zusätzlich (Browser-Mikrofon vom Handy/Tablet braucht https): 0 = aus, z. B. 8443
BRIDGE_SSL_PORT=0
# eigenes Zertifikat (PEM); leer = selbstsigniert in ~/.config/c4bridge/bridge.crt|.key (wird automatisch erzeugt)
BRIDGE_SSL_CERT=
BRIDGE_SSL_KEY=
